# Backend runtime env — copy to backend/.env and fill in your values.
#
# Replace EC2_PUBLIC_IP with your instance's public IP or public DNS hostname.

# Supabase (must match your frontend Supabase project)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub Personal Access Token (read:repo scope is enough)
GITHUB_ACCESS_TOKEN=ghp_your_token_here

# Must match the URL your frontend is served from — used for CORS
FRONTEND_URL=https://YOUR_SUBDOMAIN.duckdns.org

# GitHub App credentials (leave blank unless you configured a GitHub App)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
